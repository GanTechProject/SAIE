# SAIE Environment Configuration
# Copy this file to .env and fill in your values

# Database — Prisma resolves relative to prisma/schema.prisma
# So file:./dev.db → prisma/dev.db (correct)
# file:./prisma/dev.db → prisma/prisma/dev.db (WRONG — double nested)
DATABASE_URL=file:./dev.db

# AI Provider (uncomment ONE)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIza...
# NVIDIA_API_KEY=nvapi-...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# OLLAMA_HOST=http://localhost:11434

# Email (SMTP) — Use App Password for Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=SAIE Intelligence Engine

# Email Recipients (comma-separated)
EMAIL_RECIPIENTS=

# Local File Export Path
LOCAL_EXPORT_PATH=./reports
EXPORT_FORMATS=html,json,csv

# Google Drive OAuth2 (optional)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SHARED_WITH=

# Schedule (Saturday 7:00 AM IST by default)
SCHEDULE_DAY=saturday
SCHEDULE_TIME=07:00
SCHEDULE_TIMEZONE=Asia/Kolkata

# Server
PORT=3001